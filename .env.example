# Supabase → Project Settings → API
# Шинэ key формат: Publishable key = хуучин anon · Secret key = хуучин service_role
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# ⚠️ ЗӨВХӨН сервер тал. Браузер руу ХЭЗЭЭ Ч гаргаж болохгүй.
# Жинхэнэ утгыг ЗӨВХӨН .env.local дотор бичнэ (энэ файл git-д орно!).
# Vercel дээр Environment Variables хэсэгт нэмнэ.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Админ эрхтэй и-мэйлүүд, таслалаар зааглана.
# Supabase дээр бүртгүүлсэн ч энд байхгүй хаяг админ хэсэгт орж чадахгүй.
# ХООСОН бол хэн ч орж чадахгүй (санамсаргүй нээгдэхээс сэргийлсэн).
ADMIN_EMAILS=admin@example.com

# Сайтын жинхэнэ хаяг — хаалганы мэдэгдлийн QR код энэ хаяг руу заана
# (жишээ нь https://soh.example.mn/197). Хоосон бол PDF татсан хуудасны
# хаягийг авна — localhost дээрээс татвал QR нь localhost руу заана!
NEXT_PUBLIC_SITE_URL=
